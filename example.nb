Cell[TextData[{
 "We want to index the amplitudes with the names of particles rather than the \
names of processes (e.g., ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CapitalDelta]", "-"], TraditionalForm]],ExpressionUUID->
  "5a5cba2d-672c-b440-a2a8-369e9de80acb"],
 " instead of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalDelta]", "-"], " ", "->", " ", 
    SuperscriptBox["\[CapitalDelta]", "-"]}], TraditionalForm]],
  ExpressionUUID->"16e23a4e-a4b3-f24f-9617-d7b3ef7b28c0"],
 "). To do this, we add a column of custom labels to the amplitude table \
using the ",
 Cell[BoxData[
  RowBox[{"labelAmps", "[", 
   RowBox[{"system", ",", " ", "colName", ",", " ", "labels", ",", "..."}], 
   "]"}]], "InlineCode",ExpressionUUID->
  "52c6f32f-1a99-fb41-9cee-0a1037fba2e7"],
 " function, which takes in the system, the name of the new custom column, \
and a list of labels for the amplitudes in the order they appear in the \
amplitude table. This change is reflected when we run ",
 Cell[BoxData[
 "printAmps"], "InlineCode",ExpressionUUID->
  "b55ebe97-e377-e94b-9e5c-7dbd2143638a"],
 " again.\n\nThere is also an ",
 Cell[BoxData[
 "unlabelAmps"], "InlineCode",ExpressionUUID->
  "630fed84-f967-1446-8d9c-8bda380dfb78"],
 " function if needed."
}], "Text",
 CellChangeTimes->{{3.9572820701919174`*^9, 3.9572820921504*^9}, {
   3.9572839137568016`*^9, 3.957283916310251*^9}, {3.957283947640291*^9, 
   3.957283948232685*^9}, {3.9572840453213654`*^9, 3.9572842802390575`*^9}, {
   3.995637121292555*^9, 3.9644509606709557`*^9}, {3.964451113826803*^9, 
   3.964451196364458*^9}, 
   3.964451253424284*^9},ExpressionUUID->"931cf7d6-3bfb-f54c-8f50-\
b8535fe44dc8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"labelAmps", "[", 
    RowBox[{"system", ",", "\"\<Particle\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(-\)]\)\>\"", 
       ",", "\"\<\!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(-\)]\)\>\"", 
       ",", "\"\<\!\(\*SuperscriptBox[\(\[CapitalSigma]\), \(*\(-\)\)]\)\>\"",
        ",", "\"\<\!\(\*SuperscriptBox[\(\[CapitalXi]\), \(*\(-\)\)]\)\>\""}],
       "}"}]}], "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Notice", " ", "the", " ", "labels", " ", "are", " ", "inputted", " ", 
