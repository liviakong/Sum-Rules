  3.988647834760689*^9, 
  3.988647841846815*^9}},ExpressionUUID->"63638d65-d4a4-4347-9f3c-\
4a67c5cd0801"],

Cell[CellGroupData[{

Cell[TextData[{
 "Define the physical system (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["D", "0"], " ", "->", " ", 
    RowBox[{
     SuperscriptBox["P", "+"], 
     SuperscriptBox["P", "-"]}]}], TraditionalForm]],ExpressionUUID->
  "da97e790-372f-0040-b343-fe1888710f72"],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.96186187051857*^9, 3.9618618772531567`*^9}, {
  3.9624681599284897`*^9, 3.962468161196415*^9}, {3.962992495198431*^9, 
  3.962992538601721*^9}, {3.965425659396185*^9, 3.965425659530676*^9}, {
  3.9886476599076195`*^9, 
  3.9572785281875896`*^9}},ExpressionUUID->"eb6fa357-27b2-814c-bd4b-\
1bb24fef4467"],

Cell["\<\
Specify the particles in the multiplets and the factors in the Hamiltonian. \
Elements must be ordered from highest to lowest m within multiplets. Particle \
multiplets must be lists of strings corresponding to the names of the \
particles, and the Hamiltonian list may contain symbolic variables and \
expressions.\
\>", "Text",
 CellChangeTimes->{{3.9669591818431606`*^9, 3.96695918508737*^9}, {
  3.966959215130106*^9, 3.966959249026575*^9}, {3.970784561795349*^9, 
  3.9707846474347897`*^9}, {3.978614081796379*^9, 3.9786140842044945`*^9}, {
  3.978728707744011*^9, 3.978728713455042*^9}, {3.98864732037397*^9, 
  3.957277946898382*^9}, {3.957278039661049*^9, 3.9572780684396057`*^9}, {
  3.9572783340881577`*^9, 3.957278335286169*^9}, {3.9644491349493523`*^9, 
  3.9644491358409405`*^9}},ExpressionUUID->"b2816cc7-43f9-2e40-bb49-\
cf7596829baa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"D0", "=", 
   RowBox[{"{", "\"\<\!\(\*SuperscriptBox[\(D\), \(0\)]\)\>\"", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HDPP", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[Lambda]", "2"]}], ",", 
     RowBox[{
      SqrtBox["2"], "*", "\[Lambda]"}], ",", 
     RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pp", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<\!\(\*SuperscriptBox[\(K\), \(+\)]\)\>\"", 
     ",", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pm", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[\(K\), \(-\)]\)\>\""}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "convenience"}], ",", " ", 
    RowBox[{
    "we", " ", "define", " ", "all", " ", "the", " ", "multiplets", " ", 
     "for", " ", "the", " ", "subsequent", " ", "examples", " ", "here", " ", 
     "as", " ", "well"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dq", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<\!\(\*SuperscriptBox[\(D\), \(-\)]\)\>\"", 
     ",", "\"\<\!\(\*SuperscriptBox[SubscriptBox[\(D\), \(s\)], \
\(-\)]\)\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B0bar", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<\!\(\*SubsuperscriptBox[OverscriptBox[\(B\), \(_\)], \(s\), \
\(0\)]\)\>\"", 
     ",", "\"\<\!\(\*SubsuperscriptBox[OverscriptBox[\(B\), \(_\)], \(d\), \
