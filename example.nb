Cell[TextData[{
 "To find the sum rules between integrated observables instead, set ",
 Cell[BoxData[
  RowBox[{"obs", " ", "->", " ", "\"\<Int\>\""}]], "InlineCode",
  ExpressionUUID->"d66fb117-4994-b148-80d8-fe75b2869169"],
 " in the ",
 Cell[BoxData[
 "generateSRs"], "InlineCode",ExpressionUUID->
  "bf691a3b-d109-e949-b1cd-1367e8268357"],
 " function. This will combine amplitudes corresponding to the same channel \
and handle combinatorial factors for identical particles from the final-state \
phase-space integrals.\n\nIn the integrated case, the amplitude table \
displays an additional column enumerating the integrated channels in the \
order they appear. Processes corresponding to the same integrated observable \
correspond to the same integrated channel number. These channels are combined \
in the A2SRs. We print the output below, suppressing the ASR output because \
it is the same in both the differential and integrated cases."
}], "Text",
 CellChangeTimes->{{3.9572795724097958`*^9, 3.9572795810493298`*^9}, {
   3.9572796733786983`*^9, 3.9572797470475464`*^9}, {3.957279894376028*^9, 
   3.957280134006321*^9}, {3.957283416834299*^9, 3.9572837577545147`*^9}, {
   3.957283972959978*^9, 3.9572839735157757`*^9}, 3.9956375355441017`*^9, {
   3.995637572393507*^9, 3.9956376619591064`*^9}, {3.995637696873373*^9, 
   3.9956377612347355`*^9}, {3.995637801841608*^9, 
   3.9644512507946453`*^9}},ExpressionUUID->"2a80bc76-83b5-2748-a66e-\
a6bc64414670"],

