   3.988648157760208*^9}, {3.988648382132929*^9, 
   3.9572785031005573`*^9}},ExpressionUUID->"71239fdc-d64d-8d49-b487-\
8b544c86bfbb"],

Cell[TextData[{
 "To format and view the output, use the ",
 Cell[BoxData[
  RowBox[{"printSystem", "[", 
   RowBox[{"system", ",", " ", 
    RowBox[{"ampType", " ", "->", " ", 
