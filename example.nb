      Abs["A(\!\(\*SuperscriptBox[SubscriptBox[\(D\), \(s\)], \(-\)]\) \
\[Rule] \!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\) \!\(\*SuperscriptBox[\(K\), \
\(-\)]\) \!\(\*SuperscriptBox[\(K\), \(-\)]\))"]^2 - 2 
      Abs["A(\!\(\*SuperscriptBox[SubscriptBox[\(D\), \(s\)], \(-\)]\) \
\[Rule] \!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\) \!\(\*SuperscriptBox[\(K\), \
\(-\)]\) \!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\))"]^2 - 2 
      Abs["A(\!\(\*SuperscriptBox[SubscriptBox[\(D\), \(s\)], \(-\)]\) \
\[Rule] \!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\) \!\(\*SuperscriptBox[\(\[Pi]\
\), \(-\)]\) \!\(\*SuperscriptBox[\(K\), \(-\)]\))"]^2 + 
      Abs["A(\!\(\*SuperscriptBox[SubscriptBox[\(D\), \(s\)], \(-\)]\) \
\[Rule] \!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\) \!\(\*SuperscriptBox[\(\[Pi]\
\), \(-\)]\) \!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\))"]^2}]]],
