Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OBm", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(-\)]\)\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[SuperscriptBox[\(\[CapitalSigma]\), \
\(*\)], \(-\)]\)\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[SuperscriptBox[\(\[CapitalXi]\), \(*\)], \
\(-\)]\)\>\"", 
      ",", "\"\<\!\(\*SuperscriptBox[\(\[CapitalOmega]\), \(-\)]\)\>\""}], 
     "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "repeat", " ", "this", " ", "again", " ", "here", " ", "for", " ",
     "reference"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HOBm", "=", 
    RowBox[{"{", "1", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"system", "=", 
   RowBox[{"generateSRs", "[", 
    RowBox[{
     RowBox[{"{", "OBm", "}"}], ",", 
     RowBox[{"{", "HOBm", "}"}], ",", 
     RowBox[{"{", "OBm", "}"}], ",", 
     RowBox[{"phys", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"printAmps", "[", "system", "]"}], ";"}]}], "Input",
